---
import CardProjeto from './CardProjeto.astro';

const projetos = [
  {
    titulo: 'API RESTful - Locadora de Vídeo',
    descricao:
      'Desenvolvimento de uma API RESTful completa para gerenciamento de uma locadora de vídeos, contemplando o cadastro de clientes, catálogo de filmes, controle de disponibilidade em estoque, locações e devoluções. Construída seguindo boas práticas de arquitetura limpa, validações de regras de negócio e persistência de dados.',
    tecnologias: ['Java', 'Spring Boot', 'API RESTful', 'SQL', 'Postman'],
    linkRepo: 'https://github.com/JoaoVictorTubino/Locadora-video',
  },
  {
    titulo: 'BackEnd VLCart',
    descricao: `Desenvolvimento backend de um software integrado a hardware utilizando VLC (Visible Light Communication / Comunicação por Luz Visível). O objetivo do projeto é criar um sistema de recomendação de ofertas em supermercados: ao passar por um corredor, o cliente tem seu dispositivo (hardware) atingido pela luz emitida por uma lâmpada de LED. O software, então, identifica a frequência dessa luz e exibe automaticamente as promoções correspondentes àquele setor.`,
    tecnologias: ['Python', 'Firebase', 'VLC (Visible Light Communication)', 'IoT / Hardware', 'API REST'],
    linkRepo: 'https://github.com/JoaoVictorTubino/VLC--brisa/tree/main/VLC-APP',
  },
];
---

<section id="projetos">
  <h2>Projetos</h2>
  <div class="grid">
    {projetos.map((projeto) => <CardProjeto {...projeto} />)}
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
  }
</style>
