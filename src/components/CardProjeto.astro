---
interface Props {
  titulo: string;
  descricao: string;
  tecnologias: string[];
  linkRepo: string;
  linkDemo?: string;
}

const { titulo, descricao, tecnologias, linkRepo, linkDemo } = Astro.props;
---

<article class="card">
  <div>
    <h3>{titulo}</h3>
    <p>{descricao}</p>
  </div>

  <div>
    <div class="tags">
      {tecnologias.map((tech) => <span>{tech}</span>)}
    </div>

    <div class="links">
      <a href={linkRepo} target="_blank" rel="noopener noreferrer">Código (GitHub)</a>
      {linkDemo && <a href={linkDemo} target="_blank" rel="noopener noreferrer">Ver Online ↗</a>}
    </div>
  </div>
</article>

<style>
  .card {
    background: var(--bg-card);
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  h3 {
    margin-bottom: 0.75rem;
    font-size: 1.25rem;
  }
  p {
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }
  .tags span {
    font-size: 0.75rem;
    background: #0f172a;
    color: var(--accent);
    padding: 0.25rem 0.6rem;
    border-radius: 4px;
    border: 1px solid #1e293b;
  }
  .links {
    display: flex;
    gap: 1rem;
  }
  a {
    color: var(--text);
    font-size: 0.9rem;
    text-decoration: underline;
  }
  a:hover {
    color: var(--accent);
  }
</style>
