<footer id="contato">
  <h2>Vamos conversar?</h2>
  <p>Estou aberto a oportunidades, projetos ou troca de ideias sobre Engenharia de Software, QA e DevOps.</p>
  
  <div class="redes">
    <button type="button" id="btn-abrir-email" class="btn-contato">E-mail</button>
    <a href="https://github.com/JoaoVictorTubino" target="_blank" rel="noopener noreferrer" class="btn-contato">GitHub</a>
    <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="btn-contato">LinkedIn</a>
  </div>

  <small>© 2026 João Victor Tubino Martins. Feito com Astro.</small>

  <dialog id="modal-email">
    <div class="modal-conteudo">
      <h3>Entre em contato</h3>
      <p>Você pode me enviar uma mensagem diretamente pelo endereço abaixo:</p>
      
      <div class="email-box">
        <span id="texto-email">joaom8610@gmail.com</span>
        <button type="button" id="btn-copiar" class="btn-copiar">Copiar</button>
      </div>

      <div class="modal-acoes">
        <button type="button" id="btn-fechar-modal" class="btn-fechar">Fechar</button>
      </div>
    </div>
  </dialog>
</footer>

<script>
  const btnAbrir = document.getElementById('btn-abrir-email');
  const modal = document.getElementById('modal-email') as HTMLDialogElement;
  const btnFechar = document.getElementById('btn-fechar-modal');
  const btnCopiar = document.getElementById('btn-copiar');
  const textoEmail = document.getElementById('texto-email');

  btnAbrir?.addEventListener('click', () => {
    modal?.showModal();
  });

  btnFechar?.addEventListener('click', () => {
    modal?.close();
  });

  modal?.addEventListener('click', (event) => {
    if (event.target === modal) {
      modal.close();
    }
  });

  btnCopiar?.addEventListener('click', async () => {
    if (!textoEmail) return;
    await navigator.clipboard.writeText(textoEmail.textContent || '');
    
    const textoOriginal = btnCopiar.textContent;
    btnCopiar.textContent = 'Copiado!';
    btnCopiar.classList.add('copiado');
    
    setTimeout(() => {
      btnCopiar.textContent = textoOriginal;
      btnCopiar.classList.remove('copiado');
    }, 2000);
  });
</script>

