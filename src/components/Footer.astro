    margin-bottom: 0.5rem;
  }

  .modal-conteudo p {
    font-size: 0.95rem;
    margin-bottom: 1.25rem;
  }

  .email-box {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    background: var(--bg);
    border: 1px solid #334155;
    padding: 0.65rem 0.9rem;
    border-radius: 6px;
    margin-bottom: 1.5rem;
  }

  #texto-email {
    font-family: monospace;
    font-size: 0.95rem;
    color: var(--text);
    user-select: all;
  }

  .btn-copiar {
    background: var(--accent);
    color: #0f172a;
    border: none;
    padding: 0.4rem 0.85rem;
    border-radius: 4px;
    font-weight: 600;
    font-size: 0.85rem;
    cursor: pointer;
    transition: opacity 0.2s;
  }

  .btn-copiar:hover {
    opacity: 0.9;
  }

  .btn-copiar.copiado {
