---
const formacoes = [
  {
    curso: 'Bacharelado em Engenharia de Software',
    instituicao: 'Universidade Federal do Pampa (UNIPAMPA) - Campus Alegrete',
    periodo: '2022 - 2026',
    status: 'Concluído',
  },
  {
    curso: 'Técnico em Informática',
    instituicao: 'Instituto Federal Farroupilha (IFFAR)',
    periodo: '2019 - 2021',
    status: 'Concluído',
  },
];
---

<section id="formacao">
  <h2>Formação Acadêmica</h2>
  
  <div class="timeline">
    {formacoes.map((item) => (
      <article class="formacao-card">
        <div class="cabecalho">
          <div>
            <h3>{item.curso}</h3>
            <p class="instituicao">{item.instituicao}</p>
          </div>
          <div class="meta">
            {item.periodo && <span class="periodo">{item.periodo}</span>}
            <span class="status">{item.status}</span>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .timeline {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .formacao-card {
    background: var(--bg-card);
    border: 1px solid #334155;
    border-left: 4px solid var(--accent);
    border-radius: 8px;
    padding: 1.5rem;
  }

  .cabecalho {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 1rem;
  }

  h3 {
    font-size: 1.2rem;
    color: var(--text);
    margin-bottom: 0.25rem;
  }

  .instituicao {
    color: var(--accent);
    font-weight: 500;
    font-size: 0.95rem;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .periodo {
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .status {
    background: rgba(56, 189, 248, 0.1);
    color: var(--accent);
    border: 1px solid rgba(56, 189, 248, 0.3);
    padding: 0.2rem 0.65rem;
    border-radius: 99px;
    font-size: 0.8rem;
    font-weight: 500;
  }
</style>
